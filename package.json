{
  "name": "cloud-orchestrator",
  "version": "1.0.0",
  "description": "Cloud Orchestrator - Automated Deployments & Monitoring",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix CI-CD-backend && npm install --prefix CI-CD-Frontend",
    "dev:backend": "npm run dev --prefix CI-CD-backend",
    "dev:frontend": "npm run dev --prefix CI-CD-Frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
